# Copy to .env and fill in. .env is git-ignored and is never read by tooling
# that writes to the repository — a secret belongs in it, and nowhere else.

# ── The record store ────────────────────────────────────────────────────────
# The application connects as orbit_app, which holds INSERT and SELECT on the
# immutable tables and nothing else. Migrations run as the owner, separately.
#
# These three are the truth about where the database is. `pnpm run setup`
# creates and migrates whatever they name, through the postgres driver this
# repository already ships — no psql, and no assumption that the server is
# installed on this machine.
#
# The values below guess a postgres installed locally, on a socket, answering
# as you. For one in a container, published on 5432, the owner is usually the
# role the image was started with:
#
#   ORBIT_DATABASE_URL=postgres://orbit_app:orbit_app_local_only@localhost:5432/orbit2_dev
#   ORBIT_OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orbit2_dev
#   ORBIT_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orbit2_test
#
# Edit these before running setup. orbit_app is created by migration 0001 with
# the password below, so that line is the same either way.
ORBIT_DATABASE_URL=postgres://orbit_app:orbit_app_local_only@localhost/orbit2_dev
ORBIT_OWNER_DATABASE_URL=postgres://you@localhost/orbit2_dev
ORBIT_TEST_DATABASE_URL=postgres://you@localhost/orbit2_test

# ── Ports ──────────────────────────────────────────────────────────────────
ORBIT_PORT=4000

# ── Where evidence is written ──────────────────────────────────────────────
# Content-addressed: the digest is the address. Local disk now, S3 later, and
# the driver is all that changes.
ORBIT_EVIDENCE_DIR=./data/evidence

# ── The model ──────────────────────────────────────────────────────────────
# Needed only for AUTHORING. A published version consults no model when it
# runs (Decision 6), so the worker starts and executes with none of these set.
#
# Changing provider, or changing model within a provider, is a line here.
ORBIT_MODEL_PROVIDER=openai             # openai | bedrock
ORBIT_MODEL=gpt-4.1-mini                # the model, in the provider's words
ORBIT_MODEL_REGION=                     # bedrock only

# The model is read from ORBIT_MODEL and never hard-coded. A larger one is a
# decision with a cost attached, so it is asked for rather than assumed.
#
# Whichever provider, run `pnpm verify:model` after changing these. It makes
# one real call doing the shape of work authoring needs — read a page as
# structure, say which control an instruction means — and prints what came
# back, which model answered, and what it cost. A 200 from a provider says a
# key works and says nothing about whether the model can hold the task.
#
# ── Bedrock ────────────────────────────────────────────────────────────────
# Set no key at all. Bedrock authenticates through the ambient AWS credential
# chain — environment, shared config, SSO, or an instance role — so whether
# this machine may call it is a question only a real call can answer.
#
#   ORBIT_MODEL_PROVIDER=bedrock
#   ORBIT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   ORBIT_MODEL_REGION=us-east-1
#
# Two things that cost an afternoon, so they are written down here:
#
#   The newer Claude models are served only through a cross-region inference
#   profile. The bare `anthropic.claude-sonnet-4-5-…` is refused with
#   "on-demand throughput isn't supported"; it needs `us.` or `eu.` in front.
#
#   An Anthropic model also needs an agreement on the account. Without one
#   every call returns "Model use case details have not been submitted", which
#   points at the form even when the form is already on file — what is missing
#   is the agreement. `aws bedrock create-foundation-model-agreement` restores
#   it, against the bare model id rather than the profile.
#
# What a session costs comes from a rate table in packages/model. Claude is
# priced by model family, so it costs the same however it was reached, and
# `pnpm verify:model` prints the rate before it spends anything. A model with
# no rate held records its cost as unknown rather than as zero.
#
# ── OpenAI ─────────────────────────────────────────────────────────────────
# Matching the provider above. Never committed, never logged, never in
# evidence. Leave it blank for bedrock.
OPENAI_API_KEY=

# ── A registered application's credential ──────────────────────────────────
# The key that encrypts credentials at rest. Not in the database, so a backup
# on its own decrypts nothing (Decision 5).
ORBIT_CREDENTIAL_KEY=
