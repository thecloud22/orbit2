# Copy to .env and fill in. .env is git-ignored and is never read by tooling
# that writes to the repository — a secret belongs in it, and nowhere else.

# ── The record store ────────────────────────────────────────────────────────
# The application connects as orbit_app, which holds INSERT and SELECT on the
# immutable tables and nothing else. Migrations run as the owner, separately.
#
# These three are the truth about where the database is: scripts/setup creates
# and migrates whatever they name, rather than assuming a postgres installed
# locally. For one in a container, published on 5432, the owner is usually the
# role the image was started with:
#
#   ORBIT_DATABASE_URL=postgres://orbit_app:orbit_app_local_only@localhost:5432/orbit2_dev
#   ORBIT_OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orbit2_dev
#   ORBIT_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orbit2_test
#
# Edit these before running scripts/setup. orbit_app is created by migration
# 0001 with the password below, so that line is the same either way.
ORBIT_DATABASE_URL=postgres://orbit_app:orbit_app_local_only@localhost/orbit2_dev
ORBIT_OWNER_DATABASE_URL=postgres://you@localhost/orbit2_dev
ORBIT_TEST_DATABASE_URL=postgres://you@localhost/orbit2_test

# ── Ports ──────────────────────────────────────────────────────────────────
ORBIT_PORT=4000

# ── Where evidence is written ──────────────────────────────────────────────
# Content-addressed: the digest is the address. Local disk now, S3 later, and
# the driver is all that changes.
ORBIT_EVIDENCE_DIR=./data/evidence

# ── The model ──────────────────────────────────────────────────────────────
# Needed only for AUTHORING. A published version consults no model when it
# runs (Decision 6), so the worker starts and executes with none of these set.
#
# Changing provider, or changing model within a provider, is a line here.
ORBIT_MODEL_PROVIDER=openai             # openai | bedrock
ORBIT_MODEL=gpt-4.1-mini                # the model, in the provider's own words
ORBIT_MODEL_REGION=                     # bedrock only

# The model is read from ORBIT_MODEL and never hard-coded. A larger one is a
# decision with a cost attached, so it is asked for rather than assumed.
#
# For Bedrock, ORBIT_MODEL is a model id or an inference profile in the region
# above, and no key is set here at all — it authenticates through the ambient
# AWS credential chain, so whether this machine may call it is a question only
# a real call can answer. `pnpm verify:model` makes one:
#
#   ORBIT_MODEL_PROVIDER=bedrock
#   ORBIT_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
#   ORBIT_MODEL_REGION=eu-west-1
#
# No price is held for a Bedrock model, so the spend record says the cost is
# unknown rather than reporting zero for something that was not free.
#
# Matching the provider above. Never committed, never logged, never in
# evidence. Leave it blank for bedrock.
OPENAI_API_KEY=

# ── A registered application's credential ──────────────────────────────────
# The key that encrypts credentials at rest. Not in the database, so a backup
# on its own decrypts nothing (Decision 5).
ORBIT_CREDENTIAL_KEY=
